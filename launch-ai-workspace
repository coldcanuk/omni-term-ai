#!/usr/bin/env bash

SESSION_NAME="ai-session"

# Check if tmux is installed
if ! command -v tmux &> /dev/null; then
    echo "tmux is not installed. Please install it first."
    exit 1
fi

# Function to attach or switch to the session
attach_or_switch() {
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$SESSION_NAME"
    else
        tmux attach-session -t "$SESSION_NAME"
    fi
}

# Check if session exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Session $SESSION_NAME already exists. Attaching..."
    attach_or_switch
else
    echo "Creating new session $SESSION_NAME with top/bottom layout..."
    
    # Start a new detached session
    env -u TMUX tmux new-session -d -s "$SESSION_NAME"
    
    # We start with 1 pane (Pane 0).
    # Split vertically (-v) to create a bottom pane for the terminal.
    # We use a 50/50 split. You can resize it using the mouse or prefix+Shift+J/K.
    tmux split-window -v -t "$SESSION_NAME:0.0"
    
    # Now we have Pane 0 (Top) and Pane 1 (Bottom).
    # Split the top pane horizontally (-h) for the two bots.
    tmux split-window -h -t "$SESSION_NAME:0.0"
    
    # Now we have:
    # 0.0: Top-Left
    # 0.1: Top-Right
    # 0.2: Bottom (Terminal)
    
    # Send commands to the bots
    tmux send-keys -t "$SESSION_NAME:0.0" "agy" C-m
    tmux send-keys -t "$SESSION_NAME:0.1" "grok" C-m
    
    # Launch Neovim in the bottom terminal
    tmux send-keys -t "$SESSION_NAME:0.2" "nvim" C-m
    
    # Set focus on the bottom terminal (Pane 0.2)
    tmux select-pane -t "$SESSION_NAME:0.2"
    
    # Attach or switch to the session
    attach_or_switch
fi
