#!/usr/bin/env bash

SESSION_NAME="ai-session"

# Check if tmux is installed
if ! command -v tmux &> /dev/null; then
    echo "tmux is not installed. Please install it first."
    exit 1
fi

# Ensure Neovim config is linked
if [ ! -d "$HOME/.config/nvim" ]; then
    mkdir -p "$HOME/.config"
    ln -s /opt/repo/omni-term-ai/nvim-config "$HOME/.config/nvim"
fi

# Function to attach or switch to the session
attach_or_switch() {
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$SESSION_NAME"
    else
        tmux attach-session -t "$SESSION_NAME"
    fi
}

# Check if session exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Session $SESSION_NAME already exists. Attaching..."
    attach_or_switch
else
    echo "Creating new session $SESSION_NAME with dual-tab layout..."
    
    # Start a new detached session with Tab 1
    env -u TMUX tmux new-session -d -s "$SESSION_NAME" -n "Command Center"
    
    # Store the first window's ID so we don't care about base-index
    WIN_CMD="$SESSION_NAME:^"
    
    # Split Tab 1 into Top/Bottom
    tmux split-window -v -t "$WIN_CMD"
    # Split Top into Left/Right
    tmux split-window -h -t "$WIN_CMD.0"
    
    # Pane 0: agy, Pane 1: grok, Pane 2: bash
    tmux send-keys -t "$WIN_CMD.0" "agy" C-m
    tmux send-keys -t "$WIN_CMD.1" "grok" C-m
    
    # Tab 2: Editor (Neovim)
    tmux new-window -t "$SESSION_NAME" -n "Editor"
    WIN_ED="$SESSION_NAME:^" # Wait, `^` means first window. `$` means last window.
    
    # Let's just use window names to target them!
    tmux send-keys -t "$SESSION_NAME:=Editor" "nvim" C-m
    
    # Set focus on Tab 1 Terminal by default
    tmux select-window -t "$SESSION_NAME:=Command Center"
    tmux select-pane -t "$SESSION_NAME:=Command Center.2"
    
    # Attach or switch to the session
    attach_or_switch
fi
