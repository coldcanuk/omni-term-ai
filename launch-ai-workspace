#!/bin/sh
set -eu

if [ -f "$(dirname "$0")/lib/boot.sh" ]; then
    # shellcheck source=lib/boot.sh
    . "$(dirname "$0")/lib/boot.sh"
else
    OMNI_TERM_AI_HOME="${OMNI_TERM_AI_HOME:-@OMNI_HOME@}"
    export OMNI_TERM_AI_HOME
    # shellcheck source=/dev/null
    . "$OMNI_TERM_AI_HOME/lib/omni.sh"
fi

SESSION_NAME="${1:-ai-session}"

# Our own bin dir. The desktop entry runs this script by absolute path, often
# with a PATH that does not include it (e.g. a ~/.local install).
bindir=$(CDPATH= cd -P -- "$(dirname "$0")" && pwd) || bindir=$(dirname "$0")

die() {
    echo "$@" >&2
    echo "[Press Enter to exit]" >&2
    read -r _ </dev/tty || true
    exit 1
}

if [ ! -f "$(omni_config_path)" ] && [ -t 0 ] && [ -c /dev/tty ]; then
    echo "First time setup: configuring Omni Term AI..."
    # The sibling first, so this install's wizard runs, not another on PATH.
    if [ -x "$bindir/omni-config" ]; then
        "$bindir/omni-config"
    elif command -v omni-config >/dev/null 2>&1; then
        omni-config
    else
        die "omni-term-ai: cannot find omni-config next to $0 or on PATH"
    fi
fi

omni_load_config

# Two different jumpbox intents. Do not overload the session name to mean both.
#   no args + jumpbox set  -> run the workspace ON the jumpbox (no sshfs)
#   @target                 -> sshfs that target from the jumpbox, or abort
# OMNI_SKIP_JUMPBOX=1 skips both, including the copy we start on the jumpbox
# (otherwise a jumpbox in the remote config would ssh forever).
if [ -z "${OMNI_SKIP_JUMPBOX:-}" ]; then
    JUMPBOX=$(omni_config_get jumpbox)
    case $SESSION_NAME in
    @*)
        TARGET_NAME=${SESSION_NAME#@}
        if [ -z "$JUMPBOX" ]; then
            die "Error: Remote target specified, but no jumpbox configured. Run: omni-config set jumpbox user@host"
        fi
        if [ -z "$TARGET_NAME" ]; then
            die "Error: empty remote target. Use: launch-ai-workspace @host"
        fi
        remote=$(omni_jumpbox_target_script "$TARGET_NAME") || die "Error: could not build remote command"
        echo "Connecting to jumpbox $JUMPBOX for target $TARGET_NAME..."
        exec ssh -t -- "$JUMPBOX" "$remote"
        ;;
    ai-session)
        if [ -n "$JUMPBOX" ]; then
            echo "Connecting to jumpbox $JUMPBOX..."
            exec ssh -t -- "$JUMPBOX" 'OMNI_SKIP_JUMPBOX=1 exec launch-ai-workspace'
        fi
        ;;
    esac
fi

if ! command -v tmux >/dev/null 2>&1; then
    die "tmux is not installed. Please install it first."
fi

omni_ensure_nvim_config
export NVIM_APPNAME=omni-term-ai

PATH="$bindir:$PATH"
export PATH

# Push harness auth keys into the tmux session. A missing secret is not
# written as an empty string; that would hide keyring auth.
omni_apply_tmux_env() {
    omni_export_harness_keys
    omni_apply_azure_config
    omni_tmux set-environment -g NVIM_APPNAME omni-term-ai
    omni_tmux set-environment -g PATH "$PATH"
    omni_tmux set-environment -g OMNI_FIM_ENGINE "$OMNI_FIM_ENGINE"
    omni_tmux set-environment -g OMNI_FIM_PROVIDER "$OMNI_FIM_PROVIDER"
    omni_publish_tmux_secrets
}

attach_or_switch() {
    if [ -n "${TMUX:-}" ]; then
        omni_tmux switch-client -t "$SESSION_NAME"
    else
        omni_tmux attach-session -t "$SESSION_NAME"
    fi
}

# Which harnesses fill the two Command Center panes?
omni_load_config
LEFT_HARNESS=$(omni_config_get left)
RIGHT_HARNESS=$(omni_config_get right)

# Refuse to create a session with a harness the user does not have.
validate_harness() {
    side=$1
    harness=$2
    if ! omni_valid_harness "$harness"; then
        echo "omni-term-ai: unknown $side harness '$harness' in $(omni_config_path)" >&2
        echo "Run: omni-config set $side <grok|agy|copilot|claude|codex|deepseek>" >&2
        die ""
    fi
    if ! omni_harness_installed "$harness"; then
        bin=$(omni_harness_bin "$harness")
        echo "omni-term-ai: $side harness '$harness' needs '$bin' on PATH." >&2
        echo "Install it with:" >&2
        echo "  $(omni_harness_install_hint "$harness")" >&2
        echo "Then re-run launch-ai-workspace, or pick another harness:" >&2
        echo "  omni-config" >&2
        die ""
    fi
}

if [ ! -t 0 ] && ! [ -c /dev/tty ]; then
    if omni_tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo "Session $SESSION_NAME already exists. Attaching (non-interactive)..."
        omni_apply_tmux_env
        attach_or_switch
        exit 0
    fi
else
    while omni_tmux has-session -t "$SESSION_NAME" 2>/dev/null; do
        echo "====================================================="
        echo "Session '$SESSION_NAME' already exists!"
        echo "====================================================="
        echo " [a] Attach to the existing session (default)"
        echo " [k] Kill the existing session and create a new one"
        echo " [n] Name a new session instead"
        echo " [q] Quit"
        printf "Choice: "
        read -r choice </dev/tty || exit 1
        case "$choice" in
            a|A|"")
                echo "Attaching to $SESSION_NAME..."
                omni_apply_tmux_env
                attach_or_switch
                exit 0
                ;;
            k|K)
                echo "Killing session $SESSION_NAME..."
                omni_tmux kill-session -t "$SESSION_NAME"
                break
                ;;
            n|N)
                printf "Enter new session name: "
                read -r SESSION_NAME </dev/tty || exit 1
                if [ -z "$SESSION_NAME" ]; then
                    echo "Invalid name. Try again."
                fi
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo "Invalid choice."
                ;;
        esac
    done
fi

validate_harness left "$LEFT_HARNESS"
validate_harness right "$RIGHT_HARNESS"
LEFT_CMD=$(omni_harness_cmd "$LEFT_HARNESS")
RIGHT_CMD=$(omni_harness_cmd "$RIGHT_HARNESS")

echo "Creating new session $SESSION_NAME with dual-tab layout..."
echo "Command Center: left=$LEFT_HARNESS ($LEFT_CMD)  right=$RIGHT_HARNESS ($RIGHT_CMD)"

( unset TMUX; omni_tmux new-session -d -s "$SESSION_NAME" -n "Command Center" )

WIN_CMD="$SESSION_NAME:^"
omni_tmux split-window -v -t "$WIN_CMD"
omni_tmux split-window -h -t "$WIN_CMD.0"

omni_tmux send-keys -t "$WIN_CMD.0" "$LEFT_CMD" C-m
omni_tmux send-keys -t "$WIN_CMD.1" "$RIGHT_CMD" C-m
omni_tmux select-pane -T "$LEFT_HARNESS" -t "$WIN_CMD.0"
omni_tmux select-pane -T "$RIGHT_HARNESS" -t "$WIN_CMD.1"

omni_tmux new-window -t "$SESSION_NAME" -n "Editor"
omni_tmux send-keys -t "$SESSION_NAME:=Editor" "nvim -c \"Neotree show\"" C-m

omni_tmux select-window -t "$SESSION_NAME:=Command Center"
omni_tmux select-pane -t "$SESSION_NAME:=Command Center.2"
omni_apply_tmux_env

attach_or_switch
