#!/bin/sh
# Store and retrieve Omni Term AI API keys from the native OS secret store.
set -eu

if [ -f "$(dirname "$0")/lib/boot.sh" ]; then
    # shellcheck source=lib/boot.sh
    . "$(dirname "$0")/lib/boot.sh"
else
    OMNI_TERM_AI_HOME="${OMNI_TERM_AI_HOME:-@OMNI_HOME@}"
    export OMNI_TERM_AI_HOME
    # shellcheck source=/dev/null
    . "$OMNI_TERM_AI_HOME/lib/omni.sh"
fi

usage() {
    echo "Usage: omni-secret backend" >&2
    echo "       omni-secret get <xai|deepseek>" >&2
    echo "       omni-secret store <xai|deepseek>" >&2
    exit 1
}

valid_name() {
    case $1 in
    xai | deepseek) return 0 ;;
    *)
        echo "omni-secret: unknown key name '$1' (use xai or deepseek)" >&2
        exit 1
        ;;
    esac
}

cmd=${1:-}
case $cmd in
backend)
    omni_secret_backend
    ;;
get)
    [ $# -eq 2 ] || usage
    valid_name "$2"
    omni_secret_get "$2"
    ;;
store)
    [ $# -eq 2 ] || usage
    valid_name "$2"
    if [ -t 0 ]; then
        printf 'Enter %s API key: ' "$2" >&2
        stty -echo 2>/dev/null || true
        IFS= read -r value || true
        stty echo 2>/dev/null || true
        echo >&2
    else
        IFS= read -r value || true
    fi
    if [ -z "${value:-}" ]; then
        echo "omni-secret: empty key, not stored" >&2
        exit 1
    fi
    omni_secret_store "$2" "$value"
    echo "stored $2 via $(omni_secret_backend)" >&2
    ;;
*)
    usage
    ;;
esac
